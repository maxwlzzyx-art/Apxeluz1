{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "Android game, app, or mod package entry on APXELUZ with download mirrors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["game", "mod", "app"] },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["Official", "Unofficial"] },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "description": { "type": "string" },
        "developer": { "type": "string" },
        "porter": { "type": "string" },
        "minAndroid": { "type": "string" },
        "architecture": { "type": "string" },
        "obbRequired": { "type": "boolean" },
        "fileSizeValue": { "type": "number" },
        "fileSizeUnit": { "type": "string", "enum": ["MB", "GB"] },
        "formattedFileSize": { "type": "string" },
        "coverUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "downloadLinks": { "type": "array" },
        "visibility": { "type": "string", "enum": ["published", "draft"] },
        "rating": { "type": "number" },
        "downloadCount": { "type": "number" },
        "updatedDate": { "type": "string" }
      },
      "required": ["title", "slug", "type", "version", "category", "coverUrl", "downloadLinks"]
    },
    "Category": {
      "title": "Category",
      "description": "Category classification for games and apps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" },
        "itemCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "WebsiteSettings": {
      "title": "WebsiteSettings",
      "description": "Global website configuration for APXELUZ",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "announcement": { "type": "string" },
        "enableDownloads": { "type": "boolean" },
        "maintenanceMode": { "type": "boolean" },
        "defaultArchitecture": { "type": "string" }
      },
      "required": ["siteName", "enableDownloads"]
    }
  },
  "firestore": {
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Published and draft game and mod items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Game and app categories"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Site-wide configuration settings"
    }
  }
}
