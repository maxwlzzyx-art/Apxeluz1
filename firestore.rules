rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'pindahserverezeer@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true
      );
    }

    // Items (games, apps, mods)
    match /items/{itemId} {
      // Anyone can read published items; admins can read drafts
      allow read: if resource == null || resource.data.visibility == 'published' || isAdmin();
      // Only authenticated admins can create or delete items
      allow create, delete: if isAdmin();
      // Admins can update anything; visitors can increment downloadCount on published items
      allow update: if isAdmin() || (
        resource != null &&
        resource.data.visibility == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
      );
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Health check collection for connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
