rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid != null
      );
    }

    // Items (games, apps, mods)
    match /items/{itemId} {
      // Anyone can read published items; admins can read drafts
      allow read: if resource == null || resource.data.visibility == 'published' || isAdmin();
      // Only authenticated admins can create, update, or delete items
      allow create, update, delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Health check collection for connection testing
    match /test/{docId} {
      allow read: if true;
    }
  }
}
