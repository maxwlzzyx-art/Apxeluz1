rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'pindahserverezeer@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.admin == true
      );
    }

    // Public visitors can download any published repository assets, APKs, ZIPs, images, and attachments
    match /{allPaths=**} {
      allow read: if true;
      // Only verified administrator can upload, update, or delete files
      allow write: if isAdmin();
    }
  }
}
